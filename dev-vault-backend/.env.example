# Select a settings module explicitly in each process.
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_READ_ENV_FILE=true
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# These are local-development placeholders only. Use managed secrets outside local development.
DATABASE_URL=postgresql://devvault:devvault@127.0.0.1:5432/devvault
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

DJANGO_LOG_LEVEL=INFO
DJANGO_ENVIRONMENT=development
DEPLOYMENT_VERSION=local
READINESS_CHECK_MIGRATIONS=true

# Verification mail is saved in var/emails under development settings (never sent via SMTP).
ACCOUNT_PUBLIC_BASE_URL=http://127.0.0.1:8000
EMAIL_VERIFICATION_TTL_SECONDS=1800
PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_VERIFICATION_RESEND_SECONDS=60
DEFAULT_FROM_EMAIL=DevVault <noreply@devvault.local>
# SMTP settings are used by production; supply real credentials through managed secrets.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Dashboard JWTs. Leave the key blank only for local development (derived from DJANGO_SECRET_KEY).
# Production requires its own random signing key of at least 32 bytes, supplied through secrets.
ACCOUNT_JWT_SIGNING_KEY=
ACCOUNT_JWT_ISSUER=devvault
ACCOUNT_JWT_AUDIENCE=devvault-dashboard
ACCOUNT_ACCESS_TOKEN_SECONDS=300
ACCOUNT_REFRESH_TOKEN_SECONDS=604800

# Development derives a separate API-key pepper if this map is empty.
# Production requires random secrets (at least 32 bytes each) supplied through a secret manager.
# Retain old versions until their keys and integration credentials are rotated/revoked.
API_KEY_ACTIVE_PEPPER_VERSION=1
API_KEY_PEPPERS={}
# Local development uses a derived fallback; production requires independent Fernet keys.
# First key encrypts new secrets. Keep old keys until stored secrets are re-encrypted.
WEBHOOK_ENCRYPTION_KEYS=[]
# Outbound delivery is opt-in; leave off until destinations and egress controls are approved.
WEBHOOK_DELIVERY_ENABLED=False
# Exact frontend origins only. Dashboard tokens go in Authorization, not cookies.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Optional: independent random token (32+ characters) enables /internal/metrics/.
METRICS_TOKEN=

# Production-only examples; review before enabling.
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_HSTS_SECONDS=0
